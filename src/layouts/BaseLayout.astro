---
import Head from 'component:Head';
import Header from 'component:Header';
import SocialMenu from 'component:SocialMenu';
import { SiteMeta } from '../siteMeta';

const { description, noindex, permalink, showSkip = true, title } = Astro.props;

const thisYear = new Date().getFullYear();
---

<html class="bg-offwhite dark:bg-darkblue" lang="en">
<Head {title} description={description} noindex={noindex} permalink={permalink} />

<body class="text-darkblue dark:text-offwhite text-[20px] font-sans">
  <main>
    <header class="w-full py-4 content-width mb-0 bg-darkblue">
      {showSkip && (<a class="absolute bg-darkblue border-current -left-full m-2 outline-current p-2 ring-current text-center top-0 active:left-0 active:ring-current focus:left-0 focus:ring-current" href="#content">Skip to main content</a>)}
      <Header />
    </header>
    <slot />
    <footer class="grid gap-6 w-full py-10 content-width mb-0 bg-darkblue text-offwhite text-base">
      <div class="grid gap-6 sm:grid-cols-3">
        <div>
          <p class="font-semibold mb-2">Slushman Digital</p>
          <p class="mb-2">More customers for Wentzville-area businesses.</p>
          <a class="text-lightblue" href={`mailto:${ SiteMeta.email }`}>{SiteMeta.email}</a>
        </div>
        <nav aria-label="Services">
          <p class="font-semibold mb-2">Services</p>
          <ul class="list-reset grid gap-1">
            <li><a class="text-lightblue" href="/services/get-found/">Get found</a></li>
            <li><a class="text-lightblue" href="/services/get-chosen/">Get chosen</a></li>
            <li><a class="text-lightblue" href="/services/get-them-back/">Get them back</a></li>
            <li><a class="text-lightblue" href="/services/">All services and pricing</a></li>
          </ul>
        </nav>
        <nav aria-label="Company">
          <p class="font-semibold mb-2">More</p>
          <ul class="list-reset grid gap-1">
            <li><a class="text-lightblue" href="/work/">Work</a></li>
            <li><a class="text-lightblue" href="/about/">About</a></li>
            <li><a class="text-lightblue" href="/posts/">Blog</a></li>
            <li><a class="text-lightblue" href="/lab/">Lab</a></li>
            <li><a class="text-lightblue" href="/contact/">Contact</a></li>
          </ul>
        </nav>
      </div>
      <SocialMenu />
      <div class="text-center" data-test="copyright">{`© ${ thisYear } ${ SiteMeta.title }`}</div>
    </footer>
  </main>
</body>

</html>
