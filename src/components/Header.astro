---
import SiteTitle from 'component:SiteTitle';

const { url } = Astro.request;
const { pathname } = new URL(url);

const links = [
  { label: 'Services', href: '/services/' },
  { label: 'Work', href: '/work/' },
  { label: 'About', href: '/about/' },
  { label: 'Blog', href: '/posts/' },
];

const isCurrent = (href: string) => pathname.startsWith(href.replace(/\/$/, ''));
---
<div class="flex flex-wrap items-center justify-between gap-4">
  <p class="m-0 leading-none"><SiteTitle /></p>
  <nav aria-label="Main">
    <ul class="list-reset flex flex-wrap items-center gap-x-6 gap-y-2 text-lg">
      {links.map(({ label, href }) => (
        <li>
          <a
            aria-current={isCurrent(href) ? 'page' : undefined}
            class="text-offwhite no-underline hover:underline aria-[current=page]:underline"
            href={href}
          >{label}</a>
        </li>
      ))}
      <li>
        <a class="btn btn-primary" href="/contact/">Start a project</a>
      </li>
    </ul>
  </nav>
</div>
