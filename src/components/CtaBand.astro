---
import { SiteMeta } from '../siteMeta';
import { primaryCta } from '../data/offers';

interface Props {
  eyebrow?: string;
  title?: string;
}
const {
  eyebrow = 'No pitch deck, no pressure',
  title = 'Ready for more customers?',
} = Astro.props;
---
<section class="dark-section text-center">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-0">{title}</h2>
  <p class="max-w-prose mx-auto">
    Most local businesses start by getting found on Google Maps and getting more reviews. It's the quickest way to more calls, and it's a small first step.
  </p>
  <a class="btn btn-primary" href={primaryCta.href}>{primaryCta.label}</a>
  <p class="mt-6 mb-0 text-base">Rather talk first? Email <a href={`mailto:${SiteMeta.email}`}>{SiteMeta.email}</a>.</p>
</section>
